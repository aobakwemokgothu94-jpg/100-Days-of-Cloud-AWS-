{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EC2ReadOnlyConsoleAccess",
            "Effect": "Allow",
            "Action": [
                "ec2:Describe*",
                "ec2:Get*",
                "ec2:List*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowCloudWatchConsoleMetrics",
            "Effect": "Allow",
            "Action": [
                "cloudwatch:ListMetrics",
                "cloudwatch:GetMetricData",
                "cloudwatch:GetMetricStatistics"
            ],
            "Resource": "*"
        }
    ]
}
